# ============================================================
# .env.example — المرجع القياسي لمتغيرات البيئة
# ------------------------------------------------------------
# انسخ هذا الملف إلى `.env` ثم املأ القيم. لا تُدرِج أي قيمة حقيقية هنا.
#
#   cp .env.example .env
#   npm run env:generate     # يولّد env.js للاستضافة الاستاتيكية
#   npm run dev              # أو شغّل Vite (يقرأ .env تلقائياً)
#
# ⚠️ قسم «الواجهة الأمامية» يبقى عاماً بطبيعته (anon key / web apiKey) ويظهر
#    في المتصفح — الحماية الحقيقية في سياسات RLS وقواعد Firebase.
# ⚠️ قسم «Edge Functions» أسرار سيرفرية: تُضبط في Supabase
#    (Project Settings → Edge Functions → Secrets) ولا تُكتب في أي ملف داخل المستودع.
# ============================================================

# ------------------------------------------------------------
# 1) الواجهة الأمامية (Vite — تُقرأ بـ import.meta.env فقط)
# ------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_VAPID_PUBLIC_KEY=
# ⛔ لا يوجد أي سرّ إشعارات في الواجهة (أُزيل VITE_SEND_PUSH_SECRET نهائياً).
#    الإرسال يبدأ من تريغر pg_net داخل Supabase، والواجهة تستدعي
#    send-push برمز المستخدم (JWT) للاختبار/التشخيص فقط.

# ------------------------------------------------------------
# 2) السيرفر والدوال (Supabase Edge Functions — Deno.env.get فقط)
#    اضبطها كأسرار: supabase secrets set --env-file .env
# ------------------------------------------------------------
# إرسال مباشر من Supabase Edge Function إلى FCM HTTP v1؛ لا حاجة إلى Worker.
# ضع حساب خدمة Firebase كاملاً كـ JSON، أو اضبط المتغيرات الثلاثة المنفصلة أدناه.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# السرّ المشترك بين تريغر pg_net ودالة send-push (إلزامي، 32+ حرفاً).
# يُضبط هنا كسرّ للدالة، وتُحفظ القيمة نفسها في Supabase Vault بالاسم
# send_push_secret حتى يضعها التريغر في الترويسة:
#     x-send-push-secret: <القيمة>
# لا تُكتب القيمة في SQL أو الواجهة أو Git. انظر README §7 لإعداد Vault.
SEND_PUSH_SECRET=
# اختياري: 1 يخفض أولوية رسائل الدردشة؛ الإعداد الافتراضي high.
PUSH_NORMAL_URGENCY=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ------------------------------------------------------------
# 3) إضافي (اختياري): معرّف مشروع Agora في الواجهة
#    معرّف عام غير سرّي — الشهادة AGORA_APP_CERTIFICATE تبقى سيرفرية فقط.
# ------------------------------------------------------------
VITE_AGORA_APP_ID=

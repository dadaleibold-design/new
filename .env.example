# ============================================================
# .env.example — المرجع القياسي لمتغيرات البيئة
# ------------------------------------------------------------
# انسخ هذا الملف إلى `.env` ثم املأ القيم. لا تُدرِج أي قيمة حقيقية هنا.
#
#   cp .env.example .env
#   npm run env:generate     # يولّد env.js للاستضافة الاستاتيكية
#   npm run dev              # أو شغّل Vite (يقرأ .env تلقائياً)
#
# ⚠️ قسم «الواجهة الأمامية» يبقى عاماً بطبيعته (anon key / web apiKey) ويظهر
#    في المتصفح — الحماية الحقيقية في سياسات RLS وقواعد Firebase.
# ⚠️ قسم «Edge Functions» أسرار سيرفرية: تُضبط في Supabase
#    (Project Settings → Edge Functions → Secrets) ولا تُكتب في أي ملف داخل المستودع.
# ============================================================

# ------------------------------------------------------------
# 1) الواجهة الأمامية (Vite — تُقرأ بـ import.meta.env فقط)
# ------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_VAPID_PUBLIC_KEY=

# ------------------------------------------------------------
# 2) السيرفر والدوال (Supabase Edge Functions — Deno.env.get فقط)
#    اضبطها كأسرار: supabase secrets set --env-file .env
# ------------------------------------------------------------
# ⚠️ التعديل المعماري (v2026-10-15.1): دالة send-push لم تعد تتصل بـ FCM مباشرة
#    ولا تولّد توكنات Google OAuth2/JWT. الإرسال الفعلي عبر Cloudflare Worker
#    (بوابة الدفع) — ولذلك أسرار Firebase (FIREBASE_SERVICE_ACCOUNT /
#    FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY)
#    انتقلت إلى الـ Worker نفسه (wrangler secret put ...) ولا تُضبط هنا.
SEND_PUSH_SECRET=
# رابط بوابة الإرسال (Cloudflare Worker) — الأسمى والأوضح:
PUSH_GATEWAY_URL=
# سرّ مصادقة الـ Worker (Authorization: Bearer) — يطابق ما يتحقق منه الـ Worker:
PUSH_GATEWAY_SECRET=
# بديل مقبول لرابط الـ Worker في أسرار الدالة (يُقرأه send-push كخيار ثانٍ):
# ⚠️ انتبه: قيمة Vault بهذا الاسم شيء آخر — تبقى رابط دالة send-push نفسها
#    لتستدعيها الـ Triggers من قاعدة البيانات. لا تخلط بين المتجرّين.
SEND_PUSH_URL=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ------------------------------------------------------------
# 3) إضافي (اختياري): معرّف مشروع Agora في الواجهة
#    معرّف عام غير سرّي — الشهادة AGORA_APP_CERTIFICATE تبقى سيرفرية فقط.
# ------------------------------------------------------------
VITE_AGORA_APP_ID=

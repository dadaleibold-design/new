{
  "//": "فحص أنواع طبقة الإعداد في الواجهة (JS مع checkJs) — بلا تحويل إلى TypeScript",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["types/**/*.d.ts", "js/env.js", "js/config.js", "js/supabaseClient.js"]
}
